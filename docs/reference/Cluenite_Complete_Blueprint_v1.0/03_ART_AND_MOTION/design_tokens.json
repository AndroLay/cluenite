{
  "name": "Cluenite",
  "version": "1.0",
  "palette": {
    "ink900": "#101C2A",
    "ink800": "#192B3A",
    "ink700": "#294154",
    "paper100": "#F4F0E6",
    "paper300": "#C5D3DC",
    "clueGold": "#F5BE70",
    "proofTeal": "#75D7BD",
    "theoryLilac": "#B8AAF5",
    "warningCoral": "#F0847E",
    "neutralBlue": "#8FAABE"
  },
  "fontStack": [
    "Inter",
    "ui-sans-serif",
    "system-ui"
  ],
  "fontFilesIncluded": false,
  "radius": {
    "small": 8,
    "medium": 16,
    "large": 22
  },
  "spacingUnit": 4,
  "dimensions": {
    "stage": [
      1920,
      1080
    ],
    "quick": [
      600,
      340
    ],
    "evidenceThumbnail": [
      400,
      240
    ]
  },
  "motionMs": {
    "fast": 180,
    "mid": 420,
    "clueDiscover": 450,
    "evidenceLink": 620,
    "challenge": 720,
    "crossBreakthrough": 900,
    "quickReveal": 3400
  },
  "reducedMotion": "static states or fades under 150ms",
  "easing": {
    "enter": "cubic-bezier(.18,.72,.22,1)",
    "leave": "cubic-bezier(.4,0,.8,.3)"
  },
  "componentStates": [
    "idle",
    "hover",
    "focused",
    "selected",
    "solved",
    "refuted",
    "disabled",
    "loading",
    "disconnected"
  ],
  "stationAccents": {
    "field": "proofTeal",
    "records": "theoryLilac"
  },
  "uiLanguageDefault": "en",
  "documentationLanguage": "id"
}
