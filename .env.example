NODE_ENV=development
PORT=10000
PUBLIC_ORIGIN=http://localhost:5173
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret
TWITCH_REDIRECT_URI=http://localhost:10000/auth/twitch/callback
DATABASE_URL=postgresql://cluenite:replace-with-local-password@127.0.0.1:5432/cluenite
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-256-bit-key
OVERLAY_TOKEN_SIGNING_KEY=replace-with-a-random-256-bit-key
TWITCH_ADAPTER=simulation
LOG_LEVEL=info
