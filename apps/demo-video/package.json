{
  "name": "cluenite-demo-video",
  "version": "0.1.0",
  "private": true,
  "description": "Cluenite mystery demo film and the preserved Haiku draft.",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still src/index.ts ClueniteDemo",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/audio.mjs",
    "film:capture": "node scripts/capture-production.mjs",
    "film:prepare": "node scripts/prepare-clips.mjs",
    "film:score": "python scripts/compose-score.py",
    "film:stills": "node scripts/review-stills.mjs",
    "film:render": "node scripts/render-film.mjs",
    "commercial:score": "python scripts/compose-commercial-score.py",
    "commercial:stills": "node scripts/review-stills.mjs out/commercial-current-stills 28,105,330,520,800,950,1130,1430,1630,1740,2000,2240,2450,2640 ClueniteCommercial",
    "commercial:render": "node scripts/render-commercial.mjs",
    "commercial:assemble": "node scripts/assemble-commercial.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "@types/three": "0.187.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.540",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
